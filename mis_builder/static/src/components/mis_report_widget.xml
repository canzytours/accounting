<?xml version="1.0" encoding="utf-8" ?>
<templates>
    <t t-name="mis_builder.MisReportWidget">
        <div class="oe_mis_builder_content">
            <t t-if="this.state.mis_report_data">
                <t t-set="notes" t-value="this.state.mis_report_data.notes" />
                <div class="oe_mis_builder_cp">
                    <div class="oe_mis_builder_cp_left" />
                    <div class="oe_mis_builder_cp_right">
                        <div class="oe_mis_builder_cp_right_top_right">
                            <div class="oe_mis_builder_action_buttons">
                                <button t-on-click="() => this.toggle_wide_display()" class="btn">
                                    <i id="icon_resize" class="fa" />
                                </button>
                            </div>
                        </div>
                        <div class="oe_mis_builder_cp_right_top">
                            <SearchBar t-if="this.showSearchBar" />
                        </div>
                        <div class="oe_mis_builder_cp_right_bottom">
                            <div class="oe_mis_builder_filter_buttons">
                                <DateTimeInput
                                    value="this.state.pivot_date"
                                    placeholder="'Base date...'"
                                    type="'date'"
                                    t-if="this.showPivotDate"
                                    onChange.bind="this.onDateTimeChanged"
                                />
                            </div>
                            <div class="oe_mis_builder_action_buttons">
                                <button t-on-click="() => this.refresh()" class="btn">
                                    <span class="fa fa-refresh" /> Refresh
                                </button>
                                <button t-on-click="() => this.printPdf()" class="btn">
                                    <span class="fa fa-print" /> Print
                                </button>
                                <button t-on-click="() => this.exportXls()" class="btn">
                                    <span class="fa fa-download" /> Export
                                </button>
                                <button
                                    t-on-click="() => this.displaySettings()"
                                    t-if="this.widget_show_settings_button"
                                    class="btn"
                                >
                                    <span class="fa fa-cog" /> Settings
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="o_list_renderer o_renderer table-responsive">
                    <table class="o_list_table table table-sm table-hover table-striped mis_builder">
                        <thead>
                            <tr
                                t-foreach="this.state.mis_report_data.header"
                                t-as="row"
                                t-key="row_index"
                                class="oe_list_header_columns"
                            >
                                <th class="oe_list_header_char" />
                                <th
                                    t-foreach="row.cols"
                                    t-as="col"
                                    t-key="col_index"
                                    class="oe_list_header_char mis_builder_collabel"
                                    t-att-colspan="col.colspan"
                                >
                                    <t t-out="col.label" />
                                    <t t-if="col.description">
                                        <br />
                                        <t t-out="col.description" />
                                    </t>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr
                                t-foreach="this.state.mis_report_data.body"
                                t-as="row"
                                t-key="row_index"
                            >
                                <td t-att-style="row.style">
                                    <t t-out="row.label" />
                                    <t t-if="row.description">
                                        <br />
                                        <t t-out="row.description" />
                                    </t>
                                </td>
                                <td
                                    t-foreach="row.cells"
                                    t-as="cell"
                                    t-key="cell_index"
                                    t-att-style="cell.style"
                                    t-att-title="cell.val_c"
                                    class="mis_builder_amount oe_mis_builder_dropdown"
                                >
                                    <div>
                                        <t t-if="cell.drilldown_arg">
                                            <a
                                                href="#"
                                                class="mis_builder_drilldown"
                                                t-on-click.prevent="(ev) => this.drilldown(ev)"
                                                t-att-data-drilldown="this.JSON.stringify(cell.drilldown_arg)"
                                            >
                                                <t t-out="cell.val_r" />
                                            </a>
                                        </t>
                                        <t t-else="">
                                            <t t-out="cell.val_r" />
                                        </t>
                                        <span class="oe_mis_builder_footnote">
                                            <div t-if="notes[cell.cell_id]">
                                                <a
                                                    t-att-id="'note_' + notes[cell.cell_id].sequence"
                                                    t-out="notes[cell.cell_id].sequence"
                                                    t-att-title="notes[cell.cell_id].text"
                                                    href="#footnotes"
                                                />
                                            </div>
                                        </span>

                                        <div id="dropdown_menu" class="btn-group">
                                            <div
                                                class="dropdown"
                                                t-if="this.state.can_edit_annotation and cell.can_be_annotated"
                                            >
                                                <div
                                                    data-bs-toggle="dropdown"
                                                    class="dropdown-toggle"
                                                />
                                                <div
                                                    class="dropdown-menu o_filter_menu"
                                                    role="menu"
                                                >
                                                    <a
                                                        href="javascript:void(0)"
                                                        t-on-click="(ev) => this.annotate(ev)"
                                                        t-att-data-cell-id="cell.cell_id"
                                                        role="menuitem"
                                                        class="dropdown-item js_tag"
                                                    >
                                                        Annotate
                                                    </a>
                                                </div>
                                            </div>
                                            <div
                                                t-else=""
                                                class="dropdown-toggle oe_mis_builder_menu_disabled"
                                            />
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr />
                        </tfoot>
                    </table>
                </div>

                <!-- Table with notes -->
                <div class="oe_mis_builder_footnote_div" id="footnotes">
                    <table class="oe_mis_builder_footnote_table">
                        <tbody>
                            <t
                                t-foreach="Object.keys(notes or {})"
                                t-as="cell_id"
                                t-key="cell_id"
                            >
                                <tr>
                                    <td>
                                        <a
                                            t-out="notes[cell_id].sequence"
                                            t-att-href="'#note_' + notes[cell_id].sequence"
                                        />.
                                    </td>
                                    <td>
                                        <t t-out="notes[cell_id].text" />
                                    </td>
                                    <td>
                                        <i
                                            href="javascript:void(0)"
                                            t-on-click="(ev) => this.remove_annotation(ev)"
                                            t-att-data-cell-id="cell_id"
                                            class="btn fa fa-trash-o"
                                            t-if="this.state.can_edit_annotation"
                                        />
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </div>
    </t>
</templates>